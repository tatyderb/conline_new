# -*- coding: utf-8 -*-
# $Id$

contest_time = 0
score_system = kirov
board_fog_time = 0
board_unfog_time = 0
standings_locale = "ru"

compile_dir = "../../compile/var/compile"

team_enable_src_view
team_enable_rep_view
team_enable_ce_view
team_show_judge_report
report_error_code
ignore_compile_errors
prune_empty_users
problem_navigation
vertical_navigation


max_run_size = 32K
max_run_num = 256


stand_use_login
stand_extra_format = "%UMp1s %UMp1f %UMp1g"

rounding_mode = floor
cr_serialization_key = 22723
show_astr_time
enable_runlog_merge
secure_run
detect_violations
enable_memory_limit_error
uuid_run_store
enable_l10n
team_download_time = 0
cpu_bogomips = 4800

[language]
id = 28
short_name = "gcc-vg"
long_name = "GNU C (valgrind) 4.8.3"
arch = "valgrind"
src_sfx = ".c"

[problem]
abstract
short_name = "Generic"
use_stdin
use_stdout
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 6
real_time_limit = 14
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 32
max_process_count = 64
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
disable_user_submit = 0
disable_submit_after_ok = 0
enable_text_form

statement_file = "%Ps.html"

[problem]
abstract
short_name = "Generic_XML"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 6
real_time_limit = 14
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 32
max_process_count = 64
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
disable_user_submit = 0
disable_submit_after_ok = 0
enable_text_form

[problem]
abstract
short_name = "Generic_A"
type = "select-one"
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
full_score = 1
run_penalty = 0
disqualified_penalty = 1
advance_to_next

[problem]
abstract
short_name = "Generic_B"
type = "short-answer"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
time_limit = 1
real_time_limit = 1
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_B"

[problem]
id = 40
super = "Generic"
short_name = "tree_1"
long_name = "tree"
full_score = 60
standard_checker = "cmp_file"
enable_language = "gcc-vg"
source_header = "tree_1_begin.c"

[problem]
id = 41
super = "Generic"
short_name = "tree_11"
long_name = "tree clear"
full_score = 30
standard_checker = "cmp_file"
enable_language = "gcc-vg"
source_header = "tree_11_begin.c"

[problem]
id = 42
super = "Generic"
short_name = "tree_2"
long_name = "tree"
full_score = 30
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 43
super = "Generic"
short_name = "tree_3"
long_name = "tree depth"
full_score = 30
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 44
super = "Generic"
short_name = "tree_4"
long_name = "tree leaves"
full_score = 30
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 45
super = "Generic"
short_name = "tree_5"
long_name = "tree is balanced"
full_score = 30
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 46
super = "Generic_XML"
short_name = "tree_lvl"
long_name = "tree level"
full_score = 30
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 47
super = "Generic"
short_name = "tree_7"
long_name = "tree width"
full_score = 50
standard_checker = "cmp_file"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[tester]
name = Valgrind
arch = "valgrind"
abstract
no_core_dump
kill_signal = TERM
memory_limit_type = "valgrind"
secure_exec_type = "valgrind"
start_cmd = "runvg"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "LANG=C"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
any
super = Valgrind
arch = valgrind

