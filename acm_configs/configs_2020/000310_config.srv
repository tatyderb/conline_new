# -*- coding: utf-8 -*-
# $Id$

contest_time = 0
score_system = kirov
board_fog_time = 0
board_unfog_time = 0
standings_locale = "ru"

compile_dir = "../../compile/var/compile"

team_enable_src_view
team_enable_rep_view
team_enable_ce_view
team_show_judge_report
report_error_code
ignore_compile_errors
prune_empty_users
problem_navigation
vertical_navigation


max_run_size = 32K
max_run_num = 256


stand_use_login
stand_extra_format = "%UMp1s %UMp1f %UMp1g"

rounding_mode = floor
cr_serialization_key = 22723
show_astr_time
enable_runlog_merge
secure_run
detect_violations
enable_memory_limit_error
uuid_run_store
enable_l10n
team_download_time = 0
cpu_bogomips = 4800

[language]
id = 28
short_name = "gcc-vg"
long_name = "GNU C (valgrind) 4.8.3"
arch = "valgrind"
src_sfx = ".c"

[problem]
abstract
short_name = "Generic"
use_stdin
use_stdout
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 30
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 64
max_process_count = 64
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
use_ac_not_ok = 0
ignore_prev_ac = 0
ignore_compile_errors
disable_user_submit = 0
disable_submit_after_ok = 0
disable_security = 0
enable_suid_run = 0
enable_text_form

statement_file = "%Ps.html"

[problem]
abstract
short_name = "Generic_XML"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 10
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 64
max_process_count = 64
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
disable_user_submit = 0
disable_submit_after_ok = 0
disable_security = 0
enable_suid_run = 0
enable_text_form

[problem]
abstract
short_name = "Generic_A"
type = "select-one"
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
full_score = 1
run_penalty = 0
disqualified_penalty = 1
advance_to_next

[problem]
abstract
short_name = "Generic_B"
type = "short-answer"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
time_limit = 1
real_time_limit = 1
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_B"

[problem]
id = 40
super = "Generic"
short_name = "ram_01"
long_name = "int -> int*"
full_score = 10
standard_checker = "cmp_int_seq"
source_header = "ram_01_header.c"
source_footer = "ram_01_footer.c"

[problem]
id = 41
super = "Generic"
short_name = "ram_02"
long_name = "int* -> int"
full_score = 10
standard_checker = "cmp_int"
source_header = "ram_02_header.c"
source_footer = "ram_02_footer.c"

[problem]
id = 42
super = "Generic"
short_name = "ram_03"
long_name = "void * -> int"
full_score = 20
standard_checker = "cmp_int"
source_header = "ram_03_header.c"
source_footer = "ram_03_footer.c"

[problem]
id = 43
super = "Generic"
short_name = "ram_7"
long_name = "struct *"
full_score = 20
standard_checker = "cmp_int"
source_header = "ram_7_header.c"
source_footer = "ram_7_footer.c"

[problem]
id = 44
super = "Generic_XML"
short_name = "ram_func_01"
long_name = "передаем адрес в функцию"
full_score = 30
standard_checker = "cmp_file"
source_header = "ram_func_01_begin.c"

[problem]
id = 45
super = "Generic_XML"
short_name = "ram_func_02"
long_name = "call function"
full_score = 20
standard_checker = "cmp_int_seq"
source_header = "ram_func_02_begin.c"
source_footer = "ram_func_02_end.c"

[problem]
id = 51
super = "Generic"
short_name = "qsort_1"
long_name = "cmp int"
full_score = 20
standard_checker = "cmp_int_seq"
source_header = "qsort_1_begin.c"

[problem]
id = 52
super = "Generic"
short_name = "qsort_2"
long_name = "sort int"
full_score = 20
standard_checker = "cmp_int_seq"

[problem]
id = 53
super = "Generic"
short_name = "qsort_3"
long_name = "sort dec"
full_score = 20
standard_checker = "cmp_int_seq"

[problem]
id = 54
super = "Generic"
short_name = "qsort_4"
long_name = "sort float"
full_score = 30
standard_checker = "cmp_double_seq"
checker_env = "EPS=0.001"

[problem]
id = 55
super = "Generic"
short_name = "qsort_5"
long_name = "sort str"
full_score = 30
standard_checker = "cmp_file"

[problem]
id = 56
super = "Generic"
short_name = "qsort_6"
long_name = "sort int revers"
full_score = 30
standard_checker = "cmp_int_seq"

[problem]
id = 57
super = "Generic"
short_name = "qsort_7"
long_name = "sort even int"
full_score = 30
standard_checker = "cmp_int_seq"

[problem]
id = 58
super = "Generic"
short_name = "qsort_8"
long_name = "cmp Point"
full_score = 30
standard_checker = "cmp_int_seq"
source_header = "qsort_8_begin.c"

[problem]
id = 59
super = "Generic"
short_name = "qsort_9"
long_name = "sort Point"
full_score = 30
standard_checker = "cmp_int_seq"

[problem]
id = 60
super = "Generic"
short_name = "qsort_3_lld"
long_name = "sort big ints"
full_score = 20
standard_checker = "cmp_file"

[tester]
name = Valgrind
arch = "valgrind"
abstract
no_core_dump
kill_signal = TERM
memory_limit_type = "valgrind"
secure_exec_type = "valgrind"
start_cmd = "runvg"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "LANG=C"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
any
super = Valgrind
arch = valgrind

