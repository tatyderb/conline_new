# -*- coding: utf-8 -*-
# $Id$

contest_time = 0
score_system = kirov
board_fog_time = 0
board_unfog_time = 0
standings_locale = "ru"

compile_dir = "../../compile/var/compile"

team_enable_src_view
team_enable_rep_view
team_enable_ce_view
team_show_judge_report
report_error_code
ignore_compile_errors
prune_empty_users
problem_navigation
vertical_navigation


max_run_size = 32K
max_run_num = 256


stand_fancy_style
stand_extra_format = "%UMp1s %UMp1f %UMp1g"

rounding_mode = floor
cr_serialization_key = 22723
show_astr_time
enable_runlog_merge
secure_run
detect_violations
enable_memory_limit_error
uuid_run_store
enable_l10n
team_download_time = 0
cpu_bogomips = 4800

[language]
id = 2
short_name = "gcc"
long_name = "GNU C 4.7.2"
src_sfx = ".c"

[language]
id = 28
short_name = "gcc-vg"
long_name = "GNU C (valgrind) 4.8.3"
arch = "valgrind"
src_sfx = ".c"

[problem]
abstract
short_name = "Generic"
use_stdin
use_stdout
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 10
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 32
max_process_count = 32
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full -lm"
disable_user_submit = 0
disable_submit_after_ok = 0
enable_text_form

statement_file = "%Ps.html"

[problem]
abstract
short_name = "Generic_XML"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 10
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 32
max_process_count = 32
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
disable_user_submit = 0
disable_submit_after_ok = 0
enable_text_form

[problem]
abstract
short_name = "Generic_A"
type = "select-one"
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
full_score = 1
run_penalty = 0
advance_to_next

[problem]
abstract
short_name = "Generic_B"
type = "short-answer"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
time_limit = 1
real_time_limit = 1
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_B"

[problem]
id = 10
super = "Generic_XML"
short_name = "f_distance"
long_name = "Расстояние"
full_score = 30
standard_checker = "cmp_double"
checker_env = "EPS=0.01"
source_header = "f_distance_begin.c"

[problem]
id = 20
super = "Generic_XML"
short_name = "f_temper"
long_name = "f_temper"
full_score = 30
standard_checker = "cmp_double"
checker_env = "EPS=0.01"
source_header = "f_temper_begin.c"

[problem]
id = 30
super = "Generic_XML"
short_name = "f_printTime"
long_name = "f_printTime"
full_score = 40
standard_checker = "cmp_int_seq"
source_header = "f_printTime_begin.c"

[problem]
id = 40
super = "Generic_XML"
short_name = "f_middle"
long_name = "Новый центр отрезка"
full_score = 40
standard_checker = "cmp_int_seq"
source_header = "f_middle_begin.c"

[problem]
id = 50
super = "Generic"
short_name = "func_m_geron"
long_name = "Формула Герона"
full_score = 40
standard_checker = "cmp_double_seq"
checker_env = "EPS=0.01"

[problem]
id = 60
super = "Generic_XML"
short_name = "f_dsum1"
long_name = "Сумма цифр(1)"
full_score = 40
standard_checker = "cmp_int_seq"
source_header = "f_dsum1_begin.c"

[problem]
id = 70
super = "Generic_XML"
short_name = "f_shifr2"
long_name = "f_shifr2"
full_score = 60
standard_checker = "cmp_int"
source_header = "f_shifr2_begin.c"

[problem]
id = 80
super = "Generic_XML"
short_name = "f_shifr1"
long_name = "f_shifr1"
full_score = 60
standard_checker = "cmp_file"
source_header = "f_shifr1_begin.c"

[problem]
id = 90
super = "Generic_XML"
short_name = "f_tret"
long_name = "f_tret"
full_score = 40
standard_checker = "cmp_double_seq"
checker_env = "EPS=0.01"
source_header = "f_tret_begin.c"

[problem]
id = 100
super = "Generic_XML"
short_name = "funcp_mirror1_c"
long_name = "Отобразить точку"
full_score = 50
standard_checker = "cmp_int_seq"

[problem]
id = 110
super = "Generic_XML"
short_name = "funcp_mirror2_c"
long_name = "Отобразить прямоугольник"
full_score = 50
standard_checker = "cmp_int_seq"

[problem]
id = 120
super = "Generic_XML"
short_name = "funcp_rotateC"
long_name = "Поворот"
full_score = 60
standard_checker = "cmp_int_seq"

[tester]
name = Generic
arch = ""
abstract
no_core_dump
enable_memory_limit_error
kill_signal = KILL
memory_limit_type = "default"
secure_exec_type = "static"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
name = Valgrind
arch = "valgrind"
abstract
no_core_dump
kill_signal = TERM
memory_limit_type = "valgrind"
secure_exec_type = "valgrind"
start_cmd = "runvg"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "LANG=C"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
any
super = Generic

[tester]
any
super = Valgrind
arch = valgrind

