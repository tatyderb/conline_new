# -*- coding: utf-8 -*-
# $Id$

contest_time = 0
score_system = kirov
board_fog_time = 0
board_unfog_time = 0
standings_locale = "ru"

compile_dir = "../../compile/var/compile"

team_enable_src_view
team_enable_rep_view
team_enable_ce_view
team_show_judge_report
report_error_code
ignore_compile_errors
prune_empty_users
problem_navigation
vertical_navigation


max_run_size = 32K
max_run_num = 256


stand_use_login
stand_extra_format = "%UMp1s %UMp1f %UMp1g"

rounding_mode = floor
cr_serialization_key = 22723
show_astr_time
enable_runlog_merge
secure_run
detect_violations
enable_memory_limit_error
uuid_run_store
enable_l10n
team_download_time = 0
cpu_bogomips = 4800

[language]
id = 2
short_name = "gcc"
long_name = "GNU C 4.7.2"
src_sfx = ".c"
disabled

[language]
id = 28
short_name = "gcc-vg"
long_name = "GNU C (valgrind) 4.8.3"
arch = "valgrind"
src_sfx = ".c"

[problem]
abstract
short_name = "Generic"
use_stdin
use_stdout
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 30
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 64
max_process_count = 64
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
use_ac_not_ok = 0
ignore_prev_ac = 0
ignore_compile_errors
disable_user_submit = 0
disable_submit_after_ok = 0
disable_security = 0
enable_suid_run = 0
enable_text_form

statement_file = "%Ps.html"

[problem]
abstract
short_name = "Generic_XML"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
info_dir = "%Ps"
tgz_dir = "%Ps"
time_limit = 4
real_time_limit = 10
max_vm_size = 64M
max_stack_size = 64M
max_file_size = 64M
max_open_file_count = 64
max_process_count = 64
full_score = 1
check_cmd = "check_%Ps"
start_env = "EJUDGE_VG_FLAGS=-q --track-origins=yes --malloc-fill=66 --free-fill=66 --error-exitcode=1 --leak-check=full"
disable_user_submit = 0
disable_submit_after_ok = 0
disable_security = 0
enable_suid_run = 0
enable_text_form

[problem]
abstract
short_name = "Generic_A"
type = "select-one"
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
full_score = 1
run_penalty = 0
disqualified_penalty = 1
advance_to_next

[problem]
abstract
short_name = "Generic_B"
type = "short-answer"
use_stdin
use_stdout
xml_file = "%Ps.xml"
test_dir = "%Ps"
test_sfx = ".dat"
use_corr
corr_dir = "%Ps"
corr_sfx = ".ans"
time_limit = 1
real_time_limit = 1
full_score = 1
run_penalty = 0
disqualified_penalty = 1
check_cmd = "check_B"

[problem]
id = 10
super = "Generic"
short_name = "ptr_1"
long_name = "malloc"
full_score = 10
standard_checker = "cmp_int_seq"
source_header = "ptr_1_begin.c"
source_footer = "ptr_1_end.c"


[problem]
id = 20
super = "Generic"
short_name = "ptr_4"
long_name = "alloc and copy"
full_score = 20
standard_checker = "cmp_double_seq"
checker_env = "EPS=0.0001"
source_header = "ptr_4_begin.c"
source_footer = "ptr_4_end.c"

[problem]
id = 30
super = "Generic"
short_name = "ptr_5"
long_name = "free"
full_score = 20
standard_checker = "cmp_file"
source_header = "ptr_5_begin.c"
source_footer = "ptr_5_end.c"

[problem]
id = 40
super = "Generic"
short_name = "mem_1"
long_name = "strdup"
full_score = 40
standard_checker = "cmp_file"
source_header = "mem_1_begin.c"

[problem]
id = 50
super = "Generic"
short_name = "mem_4"
long_name = "scanf"
full_score = 20
standard_checker = "cmp_int_seq"
style_checker_cmd = "formatter"
enable_language = "gcc-vg"

[problem]
id = 81
super = "Generic_XML"
short_name = "elong_add2"
long_name = "add+malloc"
full_score = 100
standard_checker = "cmp_file"
source_header = "elong_add2_begin.c"

[problem]
id = 82
super = "Generic_XML"
short_name = "elong_add3"
long_name = "add+2malloc"
full_score = 100
standard_checker = "cmp_file"
source_header = "elong_add3_begin.c"



[problem]
id = 100
super = "Generic_XML"
short_name = "toLongN"
long_name = "toLongN"
full_score = 50
standard_checker = "cmp_file"
source_header = "toLongN_begin.c"

[problem]
id = 120
super = "Generic_XML"
short_name = "str_bomb5_mem"
long_name = "watermelow + mem"
full_score = 80
standard_checker = "cmp_file"
source_header = "str_bomb5_mem_begin.c"

[problem]
id = 136
super = "Generic_XML"
short_name = "Points"
long_name = "динамика и файлы"
full_score = 70
input_file = "input.dat"
output_file = "output.dat"
standard_checker = "cmp_file"
source_header = "points_begin.c"

[problem]
id = 140
super = "Generic_XML"
short_name = "bin_file_num"
long_name = "Бинарный файл (среденее арифметическое)"
full_score = 70
input_file = "input.dat"
use_stdin = 0
combined_stdin = 0
standard_checker = "cmp_int"

[tester]
name = Generic
arch = ""
abstract
no_core_dump
enable_memory_limit_error
kill_signal = KILL
memory_limit_type = "default"
secure_exec_type = "static"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
name = Valgrind
arch = "valgrind"
abstract
no_core_dump
kill_signal = TERM
memory_limit_type = "valgrind"
secure_exec_type = "valgrind"
start_cmd = "runvg"
clear_env
start_env = "PATH=/usr/local/bin:/usr/bin:/bin"
start_env = "LANG=C"
start_env = "HOME"
check_dir = "work-disk/work"

[tester]
any
super = Generic

[tester]
any
super = Valgrind
arch = valgrind

